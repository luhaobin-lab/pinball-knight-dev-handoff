{
  "name": "abyss-battle-scene",
  "version": "0.1.0",
  "description": "Standalone real-core battle extraction from taptapgame-abyss-archive",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && tsc --noEmit -p src/core && vitest run",
    "test": "vitest run",
    "shots": "node tools/shots.mjs",
    "perf": "node tools/perf.mjs",
    "package": "node tools/package.mjs",
    "review": "node tools/review.mjs",
    "golden": "node tools/golden.mjs",
    "golden:calibrate": "node tools/golden.mjs --calibrate",
    "data:import": "node tools/data/import-demo.mjs",
    "data:check": "node tools/data/import-demo.mjs --check",
    "bot": "node --disable-warning=ExperimentalWarning tools/bot.mjs",
    "train": "node --disable-warning=ExperimentalWarning tools/train.mjs",
    "package:battle": "node tools/package.mjs --out delivery --name 独立战斗场景.html"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
