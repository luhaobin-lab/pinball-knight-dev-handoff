{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/codex-studio/task.schema.json",
  "title": "Codex studio persisted task v1",
  "type": "object",
  "required": ["id", "source", "target", "ownerPaths", "dependencies", "inputCommit", "status", "blocking", "revision", "contributors", "attempts", "failures", "lease", "submission", "review", "integration", "verification", "recoveries", "createdAt", "updatedAt"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"},
    "source": {"$ref": "#/$defs/nonemptyStrings"},
    "target": {
      "type": "object",
      "required": ["description", "acceptance", "forbidden"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "acceptance": {"$ref": "#/$defs/nonemptyStrings"},
        "forbidden": {"$ref": "#/$defs/nonemptyStrings"},
        "golden": {"type": ["string", "null"]}
      }
    },
    "ownerPaths": {"$ref": "#/$defs/nonemptyStrings"},
    "dependencies": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "stage"], "properties": {"id": {"type": "string", "minLength": 1}, "stage": {"enum": ["integrated", "verified"]}}}
    },
    "inputCommit": {"$ref": "#/$defs/commit"},
    "status": {"enum": ["queued", "implementing", "review", "ready", "integrated", "verified", "rework", "blocked"]},
    "blocking": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "revision": {"type": "integer", "minimum": 1},
    "contributors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "attempts": {"type": "object", "required": ["develop", "review", "integrate", "verify"], "additionalProperties": {"type": "integer", "minimum": 0}},
    "failures": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "lease": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/lease"}]},
    "submission": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/receipt"}]},
    "review": {"oneOf": [{"type": "null"}, {"allOf": [{"$ref": "#/$defs/receipt"}, {"type": "object", "required": ["decision", "submissionRevision"], "properties": {"decision": {"enum": ["pass", "reject"]}, "submissionRevision": {"type": "integer", "minimum": 1}}}]}]},
    "integration": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/receipt"}]},
    "verification": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/receipt"}]},
    "recoveries": {"type": "array", "items": {"type": "object"}},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "historical": {"type": "object", "required": ["importedBy", "at", "provenance"]}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[a-fA-F0-9]{7,40}$"},
    "nonemptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["path", "summary", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "commit": {"$ref": "#/$defs/commit"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
    },
    "lease": {
      "type": "object", "required": ["actor", "role", "tokenHash", "session", "acquiredAt", "expiresAt"],
      "properties": {"actor": {"type": "string", "minLength": 1}, "role": {"enum": ["develop", "review", "integrate", "verify", "controller"]}, "tokenHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "session": {"type": "string", "minLength": 1}, "acquiredAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}}
    },
    "receipt": {"type": "object", "required": ["author", "commit", "evidence"], "properties": {"author": {"type": "string", "minLength": 1}, "commit": {"$ref": "#/$defs/commit"}, "evidence": {"$ref": "#/$defs/evidence"}}}
  }
}
